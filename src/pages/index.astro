---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PresskitSlide from '../components/PresskitSlide.astro';
import SocialLinks from '../components/SocialLinks.astro';
import logo from '../components/logo.svg?raw';
import { site, isSet, whatsappLink, trayectoria, estilo, eventos } from '../data/site';

// Galería de shows: "big" ocupa dos filas. "w" es el ancho real del original (versión grande)
const galeria = [
  { base: 'img/vivo-escenario', w: 1307, alt: 'Juanse Durando en escenario con su logo de fondo', big: true },
  { base: 'img/vivo-azul', w: 1320, alt: 'Juanse Durando pasando música con luces azules' },
  { base: 'img/vivo-fiesta-u', w: 639, alt: 'Juanse Durando en Fiesta U, Santa Fe' },
  { base: 'img/vivo-gorra', w: 1320, alt: 'Juanse Durando con gorra y auriculares' },
  { base: 'img/vivo-controlador', w: 1320, alt: 'Juanse Durando en el controlador' },
  { base: 'img/vivo-xv', w: 941, alt: 'Juanse Durando tocando en un cumpleaños de 15' },
  { base: 'img/vivo-aire-libre', w: 1320, alt: 'Juanse Durando en un evento al aire libre', big: true },
  { base: 'img/vivo-cabina', w: 1320, alt: 'Juanse Durando en cabina' },
  { base: 'img/vivo-bn', w: 1320, alt: 'Juanse Durando en blanco y negro' },
  { base: 'img/vivo-gorra2', w: 1020, alt: 'Primer plano de Juanse Durando con gorra' },
];
---

<Base>
  <Intro />
  <Header />

  <main id="top">
    <section class="hero" data-hero>
      <div class="hero__media" data-hero-media>
        <img
          src="img/hero-1600.webp"
          srcset="img/hero-800.webp 800w, img/hero-1200.webp 1200w, img/hero-1600.webp 1600w, img/hero-2400.webp 2400w"
          sizes="100vw"
          alt="Juanse Durando con auriculares, retrato de estudio"
          fetchpriority="high"
        />
      </div>
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="hero__content">
        <h1 class="hero__title">
          <span class="sr-only">Juanse Durando, DJ en Santa Fe, Argentina</span>
          <span class="hero__logo" data-hero-logo aria-hidden="true" set:html={logo} />
        </h1>
        <div class="hero__actions" data-hero-line>
          <a class="icon-btn icon-btn--big icon-btn--accent" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Contratar por WhatsApp" data-magnetic>
            <Icon name="whatsapp" />
          </a>
          <SocialLinks size="big" />
        </div>
      </div>
      <div class="hero__scroll" data-hero-line aria-hidden="true"><span></span></div>
    </section>

    <PresskitSlide img="about" title="Sobre mí" heading="ABOUT" headingDim="ME" alt="Juanse Durando de perfil, en blanco y negro" side="right" id="presskit">
      <p class="pk__lead">Juan Segundo, DJ de Santa Fe, Argentina.</p>
      <p>Arrancó en la música a los 17 años, formándose en los cursos de <b>@solocachengue</b> y <b>@lajuanitaestudio</b>.</p>
      <p>Empezó tocando en eventos chicos, donde fue armando su público, ampliando su repertorio y encontrando una identidad musical propia, siempre buscando un ambiente cálido y conectar con quienes lo escuchan.</p>
    </PresskitSlide>

    <section class="retrato" aria-label="Juanse Durando sentado sobre su flight case">
      <img
        class="retrato__img"
        src="img/retrato-flightcase-1200.webp"
        srcset="img/retrato-flightcase-1200.webp 1200w, img/retrato-flightcase-1800.webp 1800w, img/retrato-flightcase-2600.webp 2600w"
        sizes="(min-width: 861px) 60vw, 100vw"
        alt="Juanse Durando sentado sobre el flight case con su logo"
        loading="lazy"
      />
      <a class="retrato__link" href={site.socials.instagram} target="_blank" rel="noopener" data-magnetic>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
        Fotos y videos
      </a>
    </section>

    <PresskitSlide img="sonido" title="Sonido y estilo" heading="SOUND & STYLE" alt="Juanse Durando mezclando en la consola" side="left">
      <p>Sus sets combinan <b>cachengue, reggaetón y pop</b> actual e internacional, con remixes, mashups y edits que le dan dinamismo y personalidad a cada presentación.</p>
      <p>Su propuesta va más allá de hacer bailar: busca sorprender con mezclas inesperadas, conectar con el público y crear momentos que queden en el recuerdo.</p>
    </PresskitSlide>

    <PresskitSlide img="experiencia" title="Experiencia" heading="EXPERIENCE" maxW={1920} alt="Juanse Durando tocando en Fiesta U" side="right">
      <p>Hizo warm up en <b>Quba</b>, <b>Samsara</b> (Mar del Plata) y <b>Boutique</b> (Pinamar), y llevó su música a <b>San Justo</b>, <b>Reconquista</b> y <b>Rosario</b>.</p>
      <p>En 2024 hizo una gira por <b>Punta del Este</b> como DJ residente del parador <b>Roll and Rock</b>, Uruguay. En Santa Fe tocó en eventos masivos como <b>Fiesta U</b> y <b>Puerto</b>, ante más de <b>4.000 personas</b>.</p>
      <p>Además, es una de las primeras opciones para eventos sociales, fiestas de XV y recepciones en Santa Fe y alrededores.</p>
    </PresskitSlide>

    <section class="trayecto" aria-label="Trayectoria">
      <ul class="sr-only">
        {trayectoria.map((t) => <li>{t}</li>)}
        {estilo.map((t) => <li>{t}</li>)}
      </ul>
      <div class="marquee marquee--lugares" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="marquee__row">
            {trayectoria.map((t) => <span>{t}</span>)}
          </div>
        ))}
      </div>
      <div class="marquee marquee--estilo marquee--reverse" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="marquee__row">
            {estilo.map((t) => <span>{t}</span>)}
          </div>
        ))}
      </div>
    </section>

    <PresskitSlide img="fiestau" title="En cabina" heading="ON STAGE" maxW={1920} alt="Juanse Durando en la cabina del escenario de Fiesta U" side="right" id="en-cabina">
      <p>Juanse se caracteriza por una actitud seria y responsable detrás de la cabina, dejando que la música sea la protagonista de cada presentación.</p>
    </PresskitSlide>

    <section class="galeria" aria-label="Fotos en vivo">
      {galeria.map((g) => (
        <figure class:list={['galeria__item', { 'galeria__item--big': g.big }]} data-reveal-img>
          <img
            src={`${g.base}-900.webp`}
            srcset={g.w > 900 ? `${g.base}-900.webp 900w, ${g.base}-1600.webp ${g.w}w` : undefined}
            sizes="(min-width: 700px) 34vw, 50vw"
            alt={g.alt}
            loading="lazy"
          />
        </figure>
      ))}
    </section>

    <PresskitSlide img="rider" title="Rider técnico" heading="TECHNICAL RIDER" alt="Juanse Durando con auriculares" side="right" id="rider">
      <dl class="rider">
        <dt>Equipamiento propio</dt>
        <dd>1x Pioneer XDJ AZ <span>(solo dentro de 350 km de Santa Fe)</span></dd>
        <dt>Mixer DJ</dt>
        <dd>1x Pioneer XDJ RX3, XZ o AZ</dd>
        <dt>CD media players</dt>
        <dd>2x CDJ 3000 / 2000 NXS2</dd>
        <dt>Mixer</dt>
        <dd>Pioneer DJM 900 / 900 NXS2 / DJM V10</dd>
        <dt>Retornos</dt>
        <dd>2x monitores activos de 15 W o más, uno de cada lado</dd>
        <dt>Mesa de equipos</dt>
        <dd>Altura entre 0,90 y 1,20 m, cubierta con tela negra o similar</dd>
      </dl>
      <p class="rider__nota">Si hace falta, prueba de sonido con el artista al menos 1 hora antes del evento.</p>
    </PresskitSlide>

    <section class="contacto contacto--retrato" id="contacto" aria-label="Contrataciones">
      <div class="contacto__media" data-contact-media>
        <img src="img/contacto-lateral-1200.webp" srcset="img/contacto-lateral-1200.webp 1200w, img/contacto-lateral-1800.webp 1800w, img/contacto-lateral-2600.webp 2600w" sizes="(min-width: 861px) 52vw, 100vw" alt="Retrato de Juanse Durando con luz lateral" loading="lazy" />
      </div>
      <div class="contacto__shade" aria-hidden="true"></div>
      <div class="contacto__content">
        <div class="contacto__logo" set:html={logo} aria-hidden="true" />
        <p class="contacto__eventos">{eventos.join(' · ')}</p>
        <div class="contacto__actions" data-reveal>
          <a class="icon-btn icon-btn--xl icon-btn--accent" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Contratar por WhatsApp" data-magnetic>
            <Icon name="whatsapp" />
          </a>
          <SocialLinks size="xl" />
          {isSet(site.email) && (
            <a class="icon-btn icon-btn--xl" href={`mailto:${site.email}`} aria-label={`Escribir a ${site.email}`} data-magnetic>
              <Icon name="mail" />
            </a>
          )}
        </div>
        {isSet(site.presskit) && (
          <a class="presskit-btn" href={site.presskit} target="_blank" rel="noopener">
            <Icon name="presskit" />
            Press kit
          </a>
        )}
      </div>
    </section>
  </main>

  <a class="contratar-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Contrataciones por WhatsApp">
    <Icon name="whatsapp" />
    Contrataciones
  </a>

  <footer class="footer">
    <span>Santa Fe · AR</span>
    <span>© {new Date().getFullYear()}</span>
  </footer>

  <script>
    import '../scripts/main';
  </script>
</Base>
