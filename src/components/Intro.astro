---
import logo from './logo.svg?raw';
---

<div class="intro" id="intro" role="dialog" aria-label="Entrada a la web de Juanse Durando">
  <div class="intro__half intro__half--top" data-intro-half></div>
  <div class="intro__half intro__half--bottom" data-intro-half></div>

  <div class="intro__bg" data-intro-bg>
    <video
      poster="img/intro-poster.jpg"
      muted
      autoplay
      loop
      playsinline
      webkit-playsinline
      preload="auto"
      disablepictureinpicture
      disableremoteplayback
      x-webkit-airplay="deny"
      tabindex="-1"
    ></video>
    <script is:inline>
      // Celular: versión liviana (540x960). PC: versión 1080x1920 para que no se vea borrosa.
      (function () {
        var v = document.currentScript.previousElementSibling;
        v.src = window.innerWidth >= 861 ? 'video/intro-loop-1080.mp4' : 'video/intro-loop.mp4';
      })();
    </script>
  </div>
  <div class="intro__grain" aria-hidden="true"></div>

  <div class="intro__logo" data-intro-logo>
    <div class="intro__logo-inner" data-intro-logo-inner set:html={logo} />
    <span class="intro__scan" data-intro-scan aria-hidden="true"></span>
  </div>

  <div class="intro__bar" aria-hidden="true"><span data-intro-bar></span></div>

  <button class="intro__enter" type="button" aria-label="Entrar" data-intro-enter>
    <span class="intro__chevron" aria-hidden="true"></span>
    <span class="intro__chevron" aria-hidden="true"></span>
  </button>
</div>
