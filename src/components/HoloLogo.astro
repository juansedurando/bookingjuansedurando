---
// Logo en versión sticker holográfico (como el troquelado impreso):
// logotipo negro sobre lámina tornasolada RGB, con grosor 3D, brillos
// y un giro suave que no para nunca.
import logo from './logo.svg?raw';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const d = logo.match(/ d="([^"]+)"/)?.[1] ?? '';

// Margen del troquel alrededor del logo (en unidades del viewBox del logo: 2400 x 655)
const M = 140;
const viewBox = `${-M} ${-M} ${2400 + M * 2} ${655 + M * 2}`;

// Forma del troquel: el logo engordado con un trazo redondo, más un bloque por renglón
// para que el borde quede liso como en el sticker impreso.
const cut = 'stroke="#000" stroke-width="240" stroke-linejoin="round" stroke-linecap="round"';
const shape = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${viewBox}">
<rect x="164" y="0" width="2063" height="291" fill="#000" ${cut}/>
<rect x="0" y="364" width="2400" height="291" fill="#000" ${cut}/>
<path d="${d}" fill="#000" ${cut}/>
</svg>`;
const mask = `url("data:image/svg+xml,${encodeURIComponent(shape)}")`;

// Tinta negra brillante (degradé suave para que no quede plana)
const ink = (id: string) => `<svg viewBox="${viewBox}" aria-hidden="true">
<defs><linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#3a3a44"/><stop offset=".45" stop-color="#0c0c10"/><stop offset="1" stop-color="#000"/>
</linearGradient></defs>
<path d="${d}" fill="url(#${id})" fill-rule="evenodd"/></svg>`;

// Capas del canto (grosor del sticker)
const edges = Array.from({ length: 10 }, (_, i) => i);
---

<div class:list={['holo', className]} style={`--holo-mask:${mask}`} aria-hidden="true">
  <div class="holo__float">
    <div class="holo__spin">
      <div class="holo__glow"><span></span></div>
      {edges.map((i) => <span class="holo__edge" style={`--i:${i}`}></span>)}
      {['front', 'back'].map((side) => (
        <div class={`holo__face holo__face--${side}`}>
          <div class="holo__foil">
            <span class="holo__shade"></span>
            <span class="holo__glare"></span>
          </div>
          <div class="holo__ink" set:html={ink(`holo-ink-${side}`)} />
          <span class="holo__spark holo__spark--a"></span>
          <span class="holo__spark holo__spark--b"></span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .holo {
    --holo-speed: 6s;
    /* grosor del sticker, proporcional al ancho */
    --holo-depth: 2.2cqw;
    container-type: inline-size;
    position: relative;
    aspect-ratio: 2680 / 935;
    perspective: 1100px;
  }

  /* Recorte con la forma del troquel */
  .holo__foil,
  .holo__edge,
  .holo__glow span {
    -webkit-mask: var(--holo-mask) center / 100% 100% no-repeat;
    mask: var(--holo-mask) center / 100% 100% no-repeat;
  }

  /* Arcoíris RGB que se usa en la lámina y en el resplandor */
  .holo__foil,
  .holo__glow span {
    background-image: linear-gradient(
      115deg,
      #ff3b6b 0%,
      #ff9a3c 9%,
      #ffe66b 18%,
      #5dff9a 28%,
      #3cf2ff 38%,
      #4d7bff 48%,
      #b44dff 58%,
      #ff4dd8 68%,
      #ff3b6b 78%,
      #ff9a3c 87%,
      #ffe66b 100%
    );
    background-size: 300% 100%;
    animation: holo-rgb calc(var(--holo-speed) * 2) linear infinite;
  }

  /* Resplandor de color detrás (gira con el sticker) */
  .holo__glow {
    position: absolute;
    inset: 2%;
    transform: translateZ(calc(var(--holo-depth) * -0.5 - 1px));
    filter: blur(4.5cqw) saturate(1.5);
    opacity: 0.55;
    animation: holo-pulse calc(var(--holo-speed) / 2) ease-in-out infinite;
  }
  .holo__glow span {
    position: absolute;
    inset: 0;
  }

  /* Flota apenas y se inclina, para que el giro no se vea rígido */
  .holo__float {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    animation: holo-float calc(var(--holo-speed) / 2) ease-in-out infinite alternate;
  }
  .holo__spin {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    animation: holo-spin var(--holo-speed) infinite;
  }

  /* Canto: capas apiladas en profundidad, plateadas con un toque de color */
  .holo__edge {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, #8d93a6, #e9ecf5 30%, #a6b4d6 50%, #f0d9ec 70%, #8d93a6);
    filter: brightness(0.62);
    transform: translateZ(calc(var(--holo-depth) * (var(--i) / 9 - 0.5)));
  }

  .holo__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(calc(var(--holo-depth) / 2 + 0.5px));
  }
  .holo__face--back {
    transform: rotateY(180deg) translateZ(calc(var(--holo-depth) / 2 + 0.5px));
  }

  .holo__foil {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .holo__face--back .holo__foil {
    animation-delay: calc(var(--holo-speed) * -0.75);
  }
  /* Volumen: luz arriba, sombra abajo, vetas finas y destellos de holograma */
  .holo__shade {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(62deg, rgba(255, 255, 255, 0) 0 7px, rgba(255, 255, 255, 0.28) 8px, rgba(255, 255, 255, 0) 10px),
      radial-gradient(circle at 18% 30%, rgba(255, 255, 255, 0.55), transparent 22%),
      radial-gradient(circle at 78% 72%, rgba(255, 255, 255, 0.4), transparent 20%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.08) 38%, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.28) 100%);
    mix-blend-mode: soft-light;
  }
  /* Haz de luz que cruza cada vez que el logo queda de frente */
  .holo__glare {
    position: absolute;
    inset: -30% -40%;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.35) 46%,
      rgba(255, 255, 255, 0.95) 50%,
      rgba(255, 255, 255, 0.35) 54%,
      transparent 60%
    );
    mix-blend-mode: overlay;
    animation: holo-glare calc(var(--holo-speed) / 2) ease-in-out infinite;
    animation-delay: calc(var(--holo-speed) / -4);
  }

  /* Letras: negro brillante con relieve (luz arriba, sombra abajo) y borde RGB */
  .holo__ink {
    position: absolute;
    inset: 0;
    filter: drop-shadow(0 -0.12cqw 0 rgba(255, 255, 255, 0.7)) drop-shadow(0 0.22cqw 0.15cqw rgba(0, 0, 0, 0.55))
      drop-shadow(-0.18cqw 0 0 rgba(255, 40, 120, 0.45)) drop-shadow(0.18cqw 0 0 rgba(0, 220, 255, 0.45));
  }
  .holo__ink :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Destellos tipo estrella */
  .holo__spark {
    position: absolute;
    width: 9cqw;
    aspect-ratio: 1;
    margin: -4.5cqw 0 0 -4.5cqw;
    background:
      radial-gradient(circle, #fff 0 6%, rgba(255, 255, 255, 0.5) 12%, transparent 40%),
      linear-gradient(90deg, transparent 48%, rgba(255, 255, 255, 0.9) 50%, transparent 52%),
      linear-gradient(0deg, transparent 48%, rgba(255, 255, 255, 0.9) 50%, transparent 52%);
    -webkit-mask: radial-gradient(circle, #000 20%, transparent 70%);
    mask: radial-gradient(circle, #000 20%, transparent 70%);
    mix-blend-mode: screen;
    opacity: 0;
    animation: holo-spark var(--holo-speed) ease-in-out infinite;
  }
  .holo__spark--a {
    left: 12%;
    top: 22%;
  }
  .holo__spark--b {
    left: 90%;
    top: 74%;
    animation-delay: calc(var(--holo-speed) * -0.45);
  }

  @keyframes holo-spin {
    0% {
      transform: rotateY(0deg);
      animation-timing-function: cubic-bezier(0.55, 0, 0.45, 1);
    }
    50% {
      transform: rotateY(180deg);
      animation-timing-function: cubic-bezier(0.55, 0, 0.45, 1);
    }
    100% {
      transform: rotateY(360deg);
    }
  }
  @keyframes holo-float {
    from { transform: translateY(-2%) rotateX(9deg) rotateZ(-2deg); }
    to { transform: translateY(2%) rotateX(-7deg) rotateZ(1.5deg); }
  }
  @keyframes holo-rgb {
    from { background-position: 0% 0; }
    to { background-position: 150% 0; }
  }
  @keyframes holo-glare {
    from { transform: translateX(-60%); }
    to { transform: translateX(60%); }
  }
  @keyframes holo-pulse {
    0%, 100% { opacity: 0.55; scale: 0.98; }
    50% { opacity: 0.95; scale: 1.1; }
  }
  @keyframes holo-spark {
    0%, 100% { opacity: 0; transform: scale(0.3) rotate(0deg); }
    8% { opacity: 1; transform: scale(1) rotate(45deg); }
    18% { opacity: 0; transform: scale(0.4) rotate(90deg); }
  }
</style>
