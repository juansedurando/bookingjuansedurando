---
// Una placa del press kit: la foto (con el título ya incluido, como en el PDF) y el texto.
// En celular el texto va debajo de la foto; en PC va encima, en el lado oscuro de la placa.
interface Props {
  img: string;
  title: string;
  alt: string;
  side?: 'left' | 'right';
  id?: string;
}
const { img, title, alt, side = 'right', id } = Astro.props;
---

<section class:list={['pk', `pk--${side}`]} id={id} aria-label={title}>
  <figure class="pk__media" data-reveal-img>
    <img
      src={`img/pk-${img}-1920.webp`}
      srcset={`img/pk-${img}-800.webp 800w, img/pk-${img}-1200.webp 1200w, img/pk-${img}-1920.webp 1920w`}
      sizes="100vw"
      alt={alt}
      loading="lazy"
      width="1920"
      height="1080"
    />
  </figure>
  <div class="pk__text" data-reveal>
    <h2 class="sr-only">{title}</h2>
    <slot />
  </div>
</section>
