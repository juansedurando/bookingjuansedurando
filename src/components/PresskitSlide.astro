---
// Una placa del press kit: foto de fondo en alta resolución (sin texto) y el título encima en HTML,
// así se ve nítido en cualquier pantalla. En celular el texto va debajo de la foto; en PC va encima,
// en el lado oscuro de la placa.
interface Props {
  img: string;
  title: string; // título para buscadores y lectores de pantalla
  heading: string; // título visible, como en el press kit
  headingDim?: string; // parte del título en gris (ej. "ME" en "ABOUT ME")
  alt: string;
  side?: 'left' | 'right';
  id?: string;
  maxW?: number; // ancho máximo que da el original (algunas fotos en vivo no llegan a 4K)
}
const { img, title, heading, headingDim, alt, side = 'right', id, maxW = 3840 } = Astro.props;
const widths = [1280, 1920, 2880, 3840].filter((w) => w <= maxW);
---

<section class:list={['pk', `pk--${side}`]} id={id} aria-label={title}>
  <figure class="pk__media" data-reveal-img>
    <img
      src={`img/pkbg-${img}-1920.webp`}
      srcset={widths.map((w) => `img/pkbg-${img}-${w}.webp ${w}w`).join(', ')}
      sizes="100vw"
      alt={alt}
      loading="lazy"
      width="3840"
      height="2160"
    />
    <p class="pk__title" aria-hidden="true">
      {heading}{headingDim && <span> {headingDim}</span>}
    </p>
  </figure>
  <div class="pk__text" data-reveal>
    <h2 class="sr-only">{title}</h2>
    <slot />
  </div>
</section>
