---
import '../styles/global.css';
import { site, isSet } from '../data/site';

const title = `${site.name} · DJ en Santa Fe, Argentina | Contrataciones`;
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = Astro.site ? new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'img/og-base.jpg', Astro.site).href : 'img/og-base.jpg';

const sameAs = Object.values(site.socials).filter(isSet);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: 'Juan Segundo Durando',
  jobTitle: 'DJ',
  description: site.description,
  url,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'AR',
  },
  ...(sameAs.length && { sameAs }),
  ...(isSet(site.whatsapp) && { telephone: `+${site.whatsapp}` }),
  ...(isSet(site.email) && { email: site.email }),
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#050505" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, DJ en ${site.city}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="sitemap" type="application/xml" href="sitemap.xml" />
    {Object.values(site.socials).filter(isSet).map((href) => <link rel="me" href={href} />)}

    <link rel="icon" href="favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="64x64" href="favicon.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Inter:wght@400;500;600&family=Unbounded:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="img/intro-poster.jpg" />

    <script is:inline>
      document.documentElement.classList.add('js', 'intro-active');
    </script>
    <noscript><style>.intro { display: none !important; }</style></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
